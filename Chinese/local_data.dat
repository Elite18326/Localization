DST_LOBBY_DEL_SERV_COMBINE_AFTER_CHARACTER="[align = ""center""][font size = ""12"" color=""ffffff""]提醒[/font][br][br][font size = ""10"" color=""269eff""]从2010年 8月 20日[/font][font size = ""10"" color=""ffffff""]开始，[br] 您只能保有五个角色。[br]删除多余的角色后，[br]您将可以登入游戏。[/font][br][br][font size = ""10"" color=""ffffff""]请删除角色。[br]所选角色 [/font][font size = ""10"" color=""f36a7c""]及时删除[/font][font size = ""10"" color=""ffffff""]后[/font][font size = ""10"" color=""f36a7c""][br]将无法复原。[/font][br][font size = ""10"" color=""ffffff""]选择时请慎重进行决定。[/font]"
DST_LOBBY_DEL_SERV_COMBINE_CHARACTER="[align = ""center""][font size = ""12"" color=""ffffff""]提醒[/font][br][br][font size = ""10"" color=""269eff""]2从2010年 8月 20日[/font][font size = ""10"" color=""ffffff""]开始，[br] 您只能保有五个角色。[br]删除多余的角色后，[br]您将可以登入游戏。[/font][br][br][font size = ""10"" color=""ffffff""]请删除其他多余的角色。[br][font size = ""10"" color=""269eff""]请在2010年 8月 20日[/font]前进行删除。[br]谢谢。[/font]"
DST_LOBBY_EMPTYNAME="[align =""center""][font size=""12""color=""f4d762""]输入角色名称[/font][br][br][font size=""10""color=""ffffff""]请输入角色名称。[/font]"
