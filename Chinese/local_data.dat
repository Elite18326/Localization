DST_MAILSYSTEM_MSG_MAIL_CONTENT_SLANGDER="[align = ""center""][font size = ""12"" color=""f4d762""]写信[/font][br][br][font size = ""10"" color=""f36a7c""]信件中包含了不可使用的[br]禁用语。[/font][br][br][font size = ""10"" color=""ffffff""]请修正邮件内容。[/font]"
