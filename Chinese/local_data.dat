DST_MAILSYSTEM_MSG_AWAY_OFF="[align = ""center""][font size = ""12"" color=""f4d762""]解除离开设定[/font][br][br][font size = ""10"" color=""269eff""]解除离开设定后，[br]之后将可以接受所有邮件。[/font][br][br][font size = ""10"" color=""ffffff""]您要解除离开设定吗？[/font]"
DST_MAILSYSTEM_MSG_AWAY_ON="[align = ""center""][font size = ""12"" color=""f4d762""]离开设定[/font][br][br][font size = ""10"" color=""f36a7c""]设定为离开状态后，[br]以后所有的信件将会变为拒绝收取，[br]无法再收取任何邮件。[/font][br][br][font size = ""10"" color=""ffffff""]您要设定为离开吗？[/font]"
DST_MAILSYSTEM_MSG_DELETE="[align = ""center""][font size = ""12"" color=""f4d762""]删除邮件[/font][br][br][font size = ""10"" color=""f36a7c""][/font]删除所选邮件。[br][br]邮件删除后，将无法复原，[br]请慎重决定。[/font][br][br][font size = ""10"" color=""ffffff""]您要删除信件吗？[/font]"
